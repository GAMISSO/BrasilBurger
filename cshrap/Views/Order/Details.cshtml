@model Models.Order

<main class="main-content">
    <div class="page-header">
        <button class="back-btn" onclick="goBack()">←</button>
        <h1 class="page-title">Commande N°@Model.Id</h1>
        <a class="btn btn-secondary ml-auto" href="@Url.Action("MyOrders", "Order")">Retour au panier</a>
    </div>

    <div class="order-card">
        <div class="order-header">
            <div class="order-info">
                <div class="order-title">Etat: <strong>@Model.StateOrder</strong></div>
                <div>Livraison: <strong>@Model.TypeLivraison</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.AdresseLivraison))
                {
                    <div>Adresse: @Model.AdresseLivraison</div>
                }
                <div>Créée le: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="order-badges">
                @if (Model.PayementId != null)
                {
                    <span class="badge badge-paid">Payée</span>
                }
                else
                {
                    <span class="badge badge-unpaid">En attente de paiement</span>
                }
            </div>
        </div>

        <div class="order-lines">
            @{ var lines = ViewBag.Lines as List<Models.OrderLine> ?? new List<Models.OrderLine>(); }
            <table class="table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Type</th>
                        <th>Quantité</th>
                        <th>Prix unitaire</th>
                        <th>Sous-total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in lines)
                    {
                        var name = l.ItemType == "Burger" ? (l.Burger?.Nom ?? "Burger") : l.ItemType == "Menu" ? (l.Menu?.Nom ?? "Menu") : (l.Complement?.Nom ?? "Complément");
                        <tr>
                            <td>@name</td>
                            <td>@l.ItemType</td>
                            <td>@l.Quantity</td>
                            <td>@l.Prix FCFA</td>
                            <td>@(l.Prix * l.Quantity) FCFA</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="total-price" id="totalPrice">Total: <strong>@Model.TotalPrix FCFA</strong></div>

        <div class="order-actions mt-3">
            @if (Model.StateOrder == "En_cours")
            {
                <a class="btn btn-primary" href="@Url.Action("Pay", "Payment", new { orderId = Model.Id })">Payer</a>
                <a class="btn btn-danger" href="@Url.Action("Cancel", "Order", new { id = Model.Id })">Annuler</a>
            }
            <a class="btn btn-secondary" href="@Url.Action("Reorder", "Order", new { id = Model.Id })">Commander à nouveau</a>
        </div>
    </div>
</main>