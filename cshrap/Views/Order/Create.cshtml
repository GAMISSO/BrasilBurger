@* Views/Order/Create.cshtml *@
@model dynamic
@{
    ViewData["Title"] = "Commander";
    var zones = ViewBag.Zones as List<Models.Zone>;
    var complements = ViewBag.Complements as List<Models.Complement>;
    var item = ViewBag.Item;
    var typeItem = ViewBag.TypeItem as string;
    var selectedComplementIds = ViewBag.SelectedComplementIds as List<int> ?? new List<int>();
    int basePrice = 0;
    if (typeItem == "burger" && item is Models.Burger b)
    {
        basePrice = b.Prix;
    }
    else if (typeItem == "menu" && item is Models.Menu m)
    {
        var burgerComp = m.Burger;
        var complementBoisson = m.MenuComplements?.FirstOrDefault(mc => mc.Complement?.TypeComplement == "boisson")?.Complement;
        var complementFrite = m.MenuComplements?.FirstOrDefault(mc => mc.Complement?.TypeComplement == "frite")?.Complement;
        if (burgerComp != null) basePrice += burgerComp.Prix;
        if (complementBoisson != null) basePrice += complementBoisson.Prix;
        if (complementFrite != null) basePrice += complementFrite.Prix;
    }
}

<div class="container my-5">
    <h1 class="mb-4">
        <i class="bi bi-cart-plus"></i> Passer une commande
    </h1>

    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header bg-brasil text-dark">
                    <h5 class="mb-0"> Détails de la commande</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="commandeForm">
                        @if (typeItem == "burger")
                        {
                            var burger = item as Models.Burger;
                            if (burger != null)
                            {
                                <input type="hidden" name="itemType" value="Burger" />
                                <input type="hidden" name="itemId" value="@burger.Id" />

                                <div class="mb-3">
                                    <h5> @burger.Nom</h5>
                                    <p class="text-muted">Délicieux burger fait maison</p>
                                    <p class="text-success fw-bold">Prix: @burger.Prix.ToString("N0") FCFA</p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Compléments (optionnel)</label>
                                    <div class="row g-2">
                                        @foreach (var comp in complements ?? new List<Models.Complement>())
                                        {
                                            var isChecked = selectedComplementIds.Contains(comp.Id);
                                            <div class="col-md-6">
                                                <div class="form-check d-flex align-items-start">
                                                    <input class="form-check-input complement-checkbox me-2" type="checkbox"
                                                        name="complementIds" value="@comp.Id" id="comp@comp.Id"
                                                        data-prix="@comp.Prix" @(isChecked ? "checked" : string.Empty)>
                                                    <label class="form-check-label w-100" for="comp@comp.Id">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span>@comp.Nom</span>
                                                            <span class="text-success">@comp.Prix.ToString("N0") FCFA</span>
                                                        </div>
                                                        <div class="mt-2 d-flex align-items-center complement-qty-row">
                                                            <small class="text-muted me-2">Quantité</small>
                                                            <input type="number" name="complementQuantities"
                                                                class="form-control form-control-sm complement-qty" value="1"
                                                                min="1" step="1" data-prix="@comp.Prix" style="width: 90px;"
                                                                @(isChecked ? string.Empty : "disabled")>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">Burger introuvable</div>
                            }
                        }
                        else if (typeItem == "menu")
                        {
                            var menu = item as Models.Menu;
                            var burgerComp = menu?.Burger;
                            var complementBoisson = menu?.MenuComplements?.FirstOrDefault(mc =>
                            mc.Complement?.TypeComplement == "boisson")?.Complement;
                            var complementFrite = menu?.MenuComplements?.FirstOrDefault(mc => mc.Complement?.TypeComplement
                            == "frite")?.Complement;
                            decimal prixTotal = 0;
                            if (burgerComp != null) prixTotal += burgerComp.Prix;
                            if (complementBoisson != null) prixTotal += complementBoisson.Prix;
                            if (complementFrite != null) prixTotal += complementFrite.Prix;

                            @if (menu != null)
                            {
                                <input type="hidden" name="itemType" value="Menu" />
                                <input type="hidden" name="itemId" value="@menu.Id" />

                                <div class="mb-3">
                                    <h5> @menu.Nom</h5>
                                    <p>Ce menu comprend :</p>
                                    <ul>
                                        @if (burgerComp != null)
                                        {
                                            <li> @burgerComp.Nom</li>
                                        }
                                        @if (complementBoisson != null)
                                        {
                                            <li> @complementBoisson.Nom</li>
                                        }
                                        @if (complementFrite != null)
                                        {
                                            <li> @complementFrite.Nom</li>
                                        }
                                    </ul>
                                    <p class="text-success fw-bold">Prix total: @prixTotal.ToString("N0") FCFA</p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">Menu introuvable</div>
                            }
                        }

                        <div class="mb-3">
                            <label class="form-label">Quantité</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="10"
                                id="quantite">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Type de service</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="typeLivraison" id="surPlace"
                                    value="SUR_PLACE" checked>
                                <label class="btn btn-outline-primary" for="surPlace">
                                    <i class="bi bi-shop"></i> Sur place
                                </label>

                                <input type="radio" class="btn-check" name="typeLivraison" id="aEmporter"
                                    value="A_EMPORTER">
                                <label class="btn btn-outline-primary" for="aEmporter">
                                    <i class="bi bi-bag"></i> À emporter
                                </label>

                                <input type="radio" class="btn-check" name="typeLivraison" id="livraison"
                                    value="LIVRAISON">
                                <label class="btn btn-outline-primary" for="livraison">
                                    <i class="bi bi-truck"></i> Livraison
                                </label>
                            </div>
                        </div>

                        <div id="livraisonDetails" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label">Zone de livraison</label>
                                <select name="zoneId" class="form-select" id="zoneSelect">
                                    <option value="">Sélectionnez une zone</option>
                                    @foreach (var zone in zones ?? new List<Models.Zone>())
                                    {
                                        <option value="@zone.id" data-prix="@zone.prix_zone">
                                            @zone.nom - @zone.prix_zone.ToString("N0") FCFA
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Adresse de livraison</label>
                                <textarea name="adresseLivraison" class="form-control" rows="3"
                                    placeholder="Rue, quartier, point de repère..."></textarea>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brasil w-100 btn-lg">
                            <i class="bi bi-check-circle"></i> Valider la commande
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-light">
                    <h5 class="mb-0"> Résumé de la commande</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Article principal</span>
                        <span class="fw-bold" id="prixBase" data-prix-base="@basePrice">@basePrice.ToString("N0")
                            FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Quantité</span>
                        <span class="fw-bold" id="quantiteDisplay">1</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" id="complementsTotal"
                        style="display: none !important;">
                        <span>Compléments</span>
                        <span class="fw-bold" id="prixComplements">0 FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" id="livraisonTotal"
                        style="display: none !important;">
                        <span>Frais de livraison</span>
                        <span class="fw-bold" id="prixLivraison">0 FCFA</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <h5>Total à payer</h5>
                        <h5 class="text-success" id="totalFinal">0 FCFA</h5>
                    </div>
                    <small class="text-muted">Paiement à l'étape suivante</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const prixBaseElement = document.getElementById('prixBase');
            const quantiteInput = document.getElementById('quantite');
            const quantiteDisplay = document.getElementById('quantiteDisplay');
            const totalFinalElement = document.getElementById('totalFinal');
            const complementCheckboxes = document.querySelectorAll('.complement-checkbox');
            const complementQtyInputs = document.querySelectorAll('.complement-qty');
            const prixComplementsElement = document.getElementById('prixComplements');
            const complementsTotalDiv = document.getElementById('complementsTotal');
            const livraisonRadios = document.querySelectorAll('input[name="typeLivraison"]');
            const livraisonDetailsDiv = document.getElementById('livraisonDetails');
            const zoneSelect = document.getElementById('zoneSelect');
            const prixLivraisonElement = document.getElementById('prixLivraison');
            const livraisonTotalDiv = document.getElementById('livraisonTotal');

            const prixBase = parseInt(prixBaseElement.getAttribute('data-prix-base')) || 0;

            function calculerTotal() {
                const quantite = parseInt(quantiteInput.value) || 1;
                quantiteDisplay.textContent = quantite;

                // Calcul compléments (avec quantités propres)
                let prixComplements = 0;
                complementCheckboxes.forEach((checkbox, idx) => {
                    const qtyInput = complementQtyInputs[idx];
                    if (checkbox.checked) {
                        const prixComp = parseInt(checkbox.getAttribute('data-prix')) || 0;
                        const qtyComp = Math.max(1, parseInt(qtyInput.value) || 1);
                        prixComplements += prixComp * qtyComp;
                    }
                });

                // Calcul livraison
                let prixLivraison = 0;
                const typeLivraisonSelected = document.querySelector('input[name="typeLivraison"]:checked');
                if (typeLivraisonSelected && typeLivraisonSelected.value === 'LIVRAISON') {
                    const selectedZone = zoneSelect.options[zoneSelect.selectedIndex];
                    if (selectedZone && selectedZone.value) {
                        prixLivraison = parseInt(selectedZone.getAttribute('data-prix')) || 0;
                    }
                }

                // Affichage compléments
                if (prixComplements > 0) {
                    prixComplementsElement.textContent = (prixComplements * quantite).toLocaleString() + ' FCFA';
                    complementsTotalDiv.style.display = 'flex';
                } else {
                    complementsTotalDiv.style.display = 'none';
                }

                // Affichage livraison
                if (prixLivraison > 0) {
                    prixLivraisonElement.textContent = prixLivraison.toLocaleString() + ' FCFA';
                    livraisonTotalDiv.style.display = 'flex';
                } else {
                    livraisonTotalDiv.style.display = 'none';
                }

                // Total = article principal (quantité) + compléments (quantités propres) + livraison
                const total = (prixBase * quantite) + prixComplements + prixLivraison;
                totalFinalElement.textContent = total.toLocaleString() + ' FCFA';
            }

            // Événements
            quantiteInput.addEventListener('input', calculerTotal);
            complementCheckboxes.forEach((checkbox, idx) => {
                const qtyInput = complementQtyInputs[idx];
                checkbox.addEventListener('change', function () {
                    qtyInput.disabled = !checkbox.checked;
                    if (!checkbox.checked) {
                        qtyInput.value = 1;
                    }
                    calculerTotal();
                });
                qtyInput.addEventListener('input', calculerTotal);
            });

            livraisonRadios.forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.value === 'LIVRAISON') {
                        livraisonDetailsDiv.style.display = 'block';
                    } else {
                        livraisonDetailsDiv.style.display = 'none';
                    }
                    calculerTotal();
                });
            });

            if (zoneSelect) {
                zoneSelect.addEventListener('change', calculerTotal);
            }

            // Calcul initial
            calculerTotal();
        });
    </script>
}