@* Views/Order/MyOrders.cshtml *@
@model List<Models.Order>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container my-5">
    <h1 class="mb-2">
        <i class="bi bi-bag-check"></i> Mon Panier - Mes Commandes
    </h1>

    @{
        var userIdClaim = User?.FindFirst("user_id")?.Value ??
        User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var sessionUserId = Context.Session.GetInt32("user_id");
    }

    <div class="alert alert-info mb-3">
        <strong>🔍 DEBUG INFO:</strong><br>
        Login: <code>@(User?.Identity?.Name ?? "NON CONNECTÉ")</code><br>
        UserId (Claims): <code>@(userIdClaim ?? "NULL")</code><br>
        UserId (Session): <code>@(sessionUserId?.ToString() ?? "NULL")</code><br>
        IsAuthenticated: <code>@(User?.Identity?.IsAuthenticated ?? false)</code><br>
        Commandes chargées: <span class="badge bg-primary">@(Model?.Count ?? 0)</span>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var order in Model)
        {
            var etatClass = order.StateOrder switch
            {
                "En_attente" => "warning",
                "Validee" => "info",
                "En_cours" => "primary",
                "Prete" => "success",
                "En_livraison" => "info",
                "Terminee" => "success",
                "Annulee" => "danger",
                _ => "secondary"
            };

            var isPaye = order.Payement != null && order.Payement.StatutPayement?.Equals("Valider",
            System.StringComparison.OrdinalIgnoreCase) == true;

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Commande N°@order.Id</strong>
                        <br>
                        <small class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="text-end">
                        <span class="badge badge-status bg-@etatClass">
                            @order.StateOrder.Replace("_", " ")
                        </span>
                        @if (isPaye)
                        {
                            <br>

                            <span class="badge bg-success mt-1">✓ Payée</span>
                        }
                        else
                        {
                            <br>

                            <span class="badge bg-warning text-dark mt-1"> Non payée</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Articles commandés :</h6>
                            @{
                                var lines = ViewBag.LinesByOrder as Dictionary<int, List<Models.OrderLine>> ?? new Dictionary<int,
                                List<Models.OrderLine>>();
                                var thisLines = lines.ContainsKey(order.Id) ? lines[order.Id] : new List<Models.OrderLine>();
                            }
                            <ul class="list-unstyled">
                                @foreach (var item in thisLines)
                                {
                                    <li class="mb-2">
                                        @if (item.ItemType == "Menu" && item.Menu != null)
                                        {
                                            <span><i class="bi bi-box"></i> <strong>Menu @item.Menu.Nom</strong> x@item.Quantity</span>
                                        }
                                        else if (item.ItemType == "Burger" && item.Burger != null)
                                        {
                                            <span><i class="bi bi-basket"></i> <strong>@item.Burger.Nom</strong> x@item.Quantity</span>
                                        }
                                        else if (item.ItemType == "Complement" && item.Complement != null)
                                        {
                                            <span><i class="bi bi-plus-circle"></i> <strong>@item.Complement.Nom</strong>
                                                x@item.Quantity</span>
                                        }
                                        <span class="text-success"> - @item.Prix.ToString("N0") FCFA</span>
                                    </li>
                                }
                            </ul>
                            <p class="mb-1">
                                <strong>Type:</strong>
                                @switch (order.TypeLivraison)
                                {
                                    case "Sur_place":
                                        <span> Sur place</span>
                                        break;
                                    case "A_retirer":
                                        <span> À emporter</span>
                                        break;
                                    case "A_livrer":
                                        <span> Livraison</span>
                                        break;
                                }
                            </p>
                            @if (order.TypeLivraison == "A_livrer")
                            {
                                <p class="mb-0"><strong>Adresse:</strong> @order.AdresseLivraison</p>
                            }
                        </div>
                        <div class="col-md-4 text-end">
                            <h3 class="text-success">@order.TotalPrix.ToString("N0") FCFA</h3>
                            @if (!isPaye && order.StateOrder == "En_cours")
                            {
                                <a href="@Url.Action("Pay", "Payment", new { orderId = order.Id })" class="btn btn-success btn-sm">
                                    <i class="bi bi-credit-card"></i> Payer maintenant
                                </a>
                            }
                            @if (isPaye)
                            {
                                <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Vous n'avez aucune commande pour le moment.
            <br>
            <a href="@Url.Action("Index", "Catalogue")" class="btn btn-primary mt-2">
                <i class="bi bi-shop"></i> Voir le catalogue
            </a>
        </div>
    }
</div>