@* Views/Order/MyOrders.cshtml *@
@model List<Models.Order>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container my-5">
    <h1 class="mb-4">
        <i class="bi bi-bag-check"></i> Mon Panier - Mes Commandes
    </h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Vous n'avez pas encore passé de commande.
            <a href="@Url.Action("Index", "Catalogue")" class="alert-link">Découvrir notre catalogue</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            var etatClass = order.StateOrder switch
            {
                "En_attente" => "warning",
                "Validee" => "info",
                "En_cours" => "primary",
                "Prete" => "success",
                "En_livraison" => "info",
                "Terminee" => "success",
                "Annulee" => "danger",
                _ => "secondary"
            };

            var isPaye = order.Payement != null && order.Payement.StatutPayement?.Equals("Valider",
            System.StringComparison.OrdinalIgnoreCase) == true;

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Commande N°@order.Id</strong>
                        <br>
                        <small class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="text-end">
                        <span class="badge badge-status bg-@etatClass">
                            @order.StateOrder.Replace("_", " ")
                        </span>
                        @if (isPaye)
                        {
                            <br>

                            <span class="badge bg-success mt-1">✓ Payée</span>
                        }
                        else
                        {
                            <br>

                            <span class="badge bg-warning text-dark mt-1"> Non payée</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Articles commandés :</h6>
                            @{
                                var lines = ViewBag.LinesByOrder as Dictionary<int, List<Models.OrderLine>> ?? new Dictionary<int,
                                List<Models.OrderLine>>();
                                var thisLines = lines.ContainsKey(order.Id) ? lines[order.Id] : new List<Models.OrderLine>();
                            }
                            <ul class="list-unstyled">
                                @foreach (var item in thisLines)
                                {
                                    <li class="mb-2">
                                        @if (item.ItemType == "Menu")
                                        {
                                            <span> <strong>@item.Burger?.Nom</strong> x@item.Quantity</span>
                                        }
                                        else if (item.ItemType == "Burger")
                                        {
                                            <span> <strong>@item.Burger?.Nom</strong> x@item.Quantity</span>
                                        }
                                        else if (item.ItemType == "Complement")
                                        {
                                            <span> <strong>@item.Complement?.Nom</strong> x@item.Quantity</span>
                                        }
                                        <span class="text-success"> - @item.Prix.ToString("N0") FCFA</span>
                                    </li>
                                }
                            </ul>
                            <p class="mb-1">
                                <strong>Type:</strong>
                                @switch (order.TypeLivraison)
                                {
                                    case "Sur_place":
                                        <span> Sur place</span>
                                        break;
                                    case "A_retirer":
                                        <span> À emporter</span>
                                        break;
                                    case "A_livrer":
                                        <span> Livraison</span>
                                        break;
                                }
                            </p>
                            @if (order.TypeLivraison == "A_livrer")
                            {
                                <p class="mb-0"><strong>Adresse:</strong> @order.AdresseLivraison</p>
                            }
                        </div>
                        <div class="col-md-4 text-end">
                            <h3 class="text-success">@order.TotalPrix.ToString("N0") FCFA</h3>
                            @if (!isPaye && order.StateOrder != "Annulee")
                            {
                                <a href="@Url.Action("Paiement", "Order", new { id = order.Id })" class="btn btn-brasil btn-sm">
                                    <i class="bi bi-credit-card"></i> Payer
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>