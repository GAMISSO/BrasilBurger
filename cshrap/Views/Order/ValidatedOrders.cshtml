@model List<Models.Order>
@{
    ViewData["Title"] = "Commandes validées";
}

<div class="container my-5">
    <h1 class="mb-4"><i class="bi bi-bag-check-fill"></i> Commandes validées</h1>

    @if (Model == null || !Model.Any())
    {
        <p class="text-muted">Aucune commande validée pour le moment.</p>
    }
    else
    {
        @foreach (var order in Model)
        {
            var isPaye = order.Payement != null && order.Payement.StatutPayement?.Equals("Valider",
            StringComparison.OrdinalIgnoreCase) == true;
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Commande N°@order.Id</strong><br />
                        <small class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success">Validée</span>
                        @if (isPaye)
                        {
                            <br />
                
                            <span class="badge bg-success mt-1">✓ Payée</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Total:</strong> @order.TotalPrix.ToString("N0") FCFA</p>
                    <p class="mb-1"><strong>Type livraison:</strong> @order.TypeLivraison</p>
                    <h6 class="mt-3">Articles :</h6>
                    @{
                        var lines = ViewBag.LinesByOrder as Dictionary<int, List<Models.OrderLine>> ?? new();
                        var thisLines = lines.ContainsKey(order.Id) ? lines[order.Id] : new List<Models.OrderLine>();
                    }
                    <ul class="list-unstyled">
                        @foreach (var item in thisLines)
                        {
                            <li class="mb-1">
                                <strong>@(item.ItemType)</strong>
                                @if (item.Burger != null)
                                {
                                    <text>@item.Burger.Nom</text>
                                    ;
                                }
                                else if (item.Menu != null)
                                {

                                    <text>@item.Menu.Nom</text>
                                    ;
                                }
                                else if (item.Complement != null)
                                {

                                    <text>@item.Complement.Nom</text>
                                    ;
                                }
                                <span>x@item.Quantity</span>
                                <span class="text-success"> - @item.Prix.ToString("N0") FCFA</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
</div>