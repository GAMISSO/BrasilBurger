@* Views/Catalogue/MenuDetails.cshtml *@
@model Models.Menu
@{
    ViewData["Title"] = Model.Nom;
    var complements = ViewBag.Complements as List<Models.Complement>;
    var burger = Model.Burger;

    // Calculer le prix total du menu
    decimal prixTotal = 0;
    if (burger != null) prixTotal += burger.Prix;
    if (complements != null)
    {
        foreach (var comp in complements)
        {
            prixTotal += comp.Prix;
        }
    }
}

<div class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Catalogue")">Catalogue</a></li>
            <li class="breadcrumb-item active">@Model.Nom</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            <img src="@(Model.Image != null ? Model.Image : "/image/menu_image.png")" class="img-fluid rounded shadow"
                alt="@Model.Nom">
            <div class="badge bg-success position-absolute top-0 start-0 m-3 fs-6">Menu Complet</div>
        </div>
        <div class="col-md-6">
            <h1 class="display-5 fw-bold">@Model.Nom</h1>
            <p class="lead text-muted">Un menu complet et savoureux</p>

            <div class="card bg-light mb-4">
                <div class="card-body">
                    <h3 class="text-success">@prixTotal.ToString("N0") FCFA</h3>
                    <small class="text-muted">Menu complet</small>
                </div>
            </div>

            <h5 class="mb-3">🍽️ Ce menu comprend :</h5>
            <div class="list-group mb-4">
                @if (burger != null)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">🍔 @burger.Nom</h6>
                                <small class="text-muted">Burger principal</small>
                            </div>
                            <span class="badge bg-success">@burger.Prix.ToString("N0") FCFA</span>
                        </div>
                    </div>
                }

                @if (complements != null && complements.Any())
                {
                    @foreach (var comp in complements)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">
                                        @if (comp.TypeComplement?.ToLower() == "boisson")
                                        {
                                            <span>🥤</span>
                                        }
                                        else if (comp.TypeComplement?.ToLower() == "frite")
                                        {
                                            <span>🍟</span>
                                        }
                                        else
                                        {
                                            <span>🍽️</span>
                                        }
                                        @comp.Nom
                                    </h6>
                                    <small class="text-muted">@comp.TypeComplement</small>
                                </div>
                                <span class="badge bg-success">@comp.Prix.ToString("N0") FCFA</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="d-grid gap-2">
                <a href="@Url.Action("Create", "Order", new { itemId = Model.Id, itemType = "menu" })"
                    class="btn btn-brasil btn-lg">
                    <i class="bi bi-cart-plus"></i> Commander ce menu
                </a>
                <a href="@Url.Action("Index", "Catalogue")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour au catalogue
                </a>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-brasil">
                    <h5 class="mb-0">ℹ️ Informations</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li>✅ Tous nos menus sont préparés à la commande</li>
                        <li>✅ Ingrédients frais et de qualité</li>
                        <li>✅ Possibilité de personnaliser votre menu</li>
                        <li>✅ Livraison disponible</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>