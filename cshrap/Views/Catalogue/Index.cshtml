@* Views/Catalogue/Index.cshtml *@
@model dynamic
@{
    ViewData["Title"] = "Catalogue";
    var burgers = ViewBag.Burgers as List<Models.Burger>;
    var menus = ViewBag.Menus as List<Models.Menu>;
}

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold"> Nos Délicieux Burgers</h1>
        <p class="lead">Découvrez notre sélection de burgers et menus</p>
    </div>
</div>

<div class="container my-5">
    <!-- Filtres -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index", "Catalogue", new { filtre = "tous" })"
                    class="btn @(ViewBag.Filtre == "tous" ? "btn-brasil" : "btn-outline-secondary")">
                    Tous
                </a>
                <a href="@Url.Action("Index", "Catalogue", new { filtre = "burger" })"
                    class="btn @(ViewBag.Filtre == "burger" ? "btn-brasil" : "btn-outline-secondary")">
                     Burgers
                </a>
                <a href="@Url.Action("Index", "Catalogue", new { filtre = "menu" })"
                    class="btn @(ViewBag.Filtre == "menu" ? "btn-brasil" : "btn-outline-secondary")">
                     Menus
                </a>
            </div>
        </div>
    </div>

    <!-- Section Burgers -->
    @if (burgers != null && burgers.Any())
    {
        <div class="mb-5">
            <h2 class="mb-4">
                <i class="bi bi-shop"></i> Nos Burgers
            </h2>
            <div class="row g-4">
                @foreach (var burger in burgers)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card card-product h-100">
                            <img src="@(burger.ImageUrl != null ? burger.ImageUrl : "/image/burger_image.png")"
                                class="card-img-top" alt="@burger.Nom">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@burger.Nom</h5>
                                <p class="card-text text-muted flex-grow-1">
                                    Délicieux burger fait maison
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="text-success mb-0">@burger.Prix.ToString("N0") FCFA</h4>
                                    <div>
                                        <a href="@Url.Action("BurgerDetails", "Catalogue", new { id = burger.Id })"
                                            class="btn btn-sm btn-outline-secondary me-2">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Create", "Order", new { itemId = burger.Id, itemType = "burger" })"
                                            class="btn btn-sm btn-brasil">
                                            <i class="bi bi-cart-plus"></i> Commander
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Section Menus -->
    @if (menus != null && menus.Any())
    {
        <div class="mb-5">
            <h2 class="mb-4">
                <i class="bi bi-cup-straw"></i> Nos Menus
            </h2>
            <div class="row g-4">
                @foreach (var menu in menus)
                {
                    var burgerComp = menu.Burger;
                    var complementBoisson = menu.MenuComplements?.FirstOrDefault(mc => mc.Complement?.TypeComplement ==
                    "boisson")?.Complement;
                    var complementFrite = menu.MenuComplements?.FirstOrDefault(mc => mc.Complement?.TypeComplement ==
                    "frite")?.Complement;
                    decimal prixTotal = 0;
                    if (burgerComp != null) prixTotal += burgerComp.Prix;
                    if (complementBoisson != null) prixTotal += complementBoisson.Prix;
                    if (complementFrite != null) prixTotal += complementFrite.Prix;

                    <div class="col-md-6 col-lg-4">
                        <div class="card card-product h-100">
                            <div class="badge bg-success position-absolute top-0 end-0 m-3">Menu Complet</div>
                            <img src="@(menu.Image != null ? menu.Image : "/images/placeholder.jpg")" class="card-img-top"
                                alt="@menu.Nom">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@menu.Nom</h5>
                                <p class="card-text">
                                    @if (burgerComp != null || complementBoisson != null || complementFrite != null)
                                    {
                                        <small class="text-muted">
                                            @if (burgerComp != null)
                                            {
                                                <span> @burgerComp.Nom</span>
                                                <br>
                                            }
                                            @if (complementBoisson != null)
                                            {
                                                <span> @complementBoisson.Nom</span>
                                                <br>
                                            }
                                            @if (complementFrite != null)
                                            {
                                                <span> @complementFrite.Nom</span>
                                            }
                                        </small>
                                    }
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <h4 class="text-success mb-0">@prixTotal.ToString("N0") FCFA</h4>
                                    <div>
                                        <a href="@Url.Action("MenuDetails", "Catalogue", new { id = menu.Id })"
                                            class="btn btn-sm btn-outline-secondary me-2">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Create", "Order", new { itemId = menu.Id, itemType = "menu" })"
                                            class="btn btn-sm btn-brasil">
                                            <i class="bi bi-cart-plus"></i> Commander
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>