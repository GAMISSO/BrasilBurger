
<main class="catalogue">
    <span class="sous-header">
        <h2>Catégorie</h2>
    </span>
    <div class="the-categorie">
        <a class="categorie-btn" asp-action="Filter" asp-route-type="burger">Burgers</a>
        <a class="categorie-btn" asp-action="Filter" asp-route-type="menu">Menus</a>
        <a class="categorie-btn" asp-action="Filter" asp-route-type="complement">Frites</a>
        <a class="categorie-btn" asp-action="Filter" asp-route-type="boisson">Boissons</a>
    </div>

    <h3>Burgers</h3>
    <div class="burger-list">
        @{
            var burgers = ViewBag.Burgers as List<Models.Burger> ?? new List<Models.Burger>();
        }

        @foreach (var b in burgers)
        {
            <div class="burger-card">
                <img src="@(b.ImageUrl ?? "/image/burger_image.png")" alt="Burger">
                <h3>@b.Nom</h3>
                <div class="detail-product">
                    <p>@String.Format("{0} FCFA", b.Prix)</p>

                @if (Context.Session.GetInt32("user_id") == null)
                {
                    <button class="btn-ajouter" onclick="openLogin()">Ajouter</button>
                }
                else
                {
                    <form method="post" asp-controller="Order" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemType" value="Burger" />
                        <input type="hidden" name="itemId" value="@b.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="typeLivraison" value="Livraison" />
                        <button type="submit" class="btn-ajouter">Ajouter</button>
                    </form>
                }
                </div>
                
            </div>
        }
    </div>
</main>

<!-- OVERLAY LOGIN -->
<div id="loginOverlay" class="overlay">
    <div class="overlay-content">

        <span class="close" onclick="closeLogin()">✕</span>

        <h2>Se connecter</h2>
        @if (TempData["error"] != null)
        {
            <p style="color:red">@TempData["error"]</p>
        }


        <form method="post" asp-controller="Auth" asp-action="Login">

            <input type="text" name="login" placeholder="Login" required />

            <input type="password" name="password" placeholder="Mot de passe" required />

            <button type="submit" class="btn-login">
                Connexion
            </button>

        </form>

        <a href="#" class="link-inscription">Inscription</a>

    </div>
</div>