@using Models

@{
    var burgers = ViewBag.Burgers as List<Burger> ?? new List<Burger>();
    var menus = ViewBag.Menus as List<Menu> ?? new List<Menu>();
    var currentFilter = (ViewBag.CurrentFilter as string) ?? "all";
}

@functions {
    public string ImgUrl(string? img)
    {
        if (string.IsNullOrWhiteSpace(img))
            return Url.Content("~/image/burger_image.png");

        if (img.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase) || img.StartsWith("https://",
        System.StringComparison.OrdinalIgnoreCase))
            return img;

        if (img.StartsWith("/"))
            return img;

        // If looks like it's stored under image folder already
        if (img.StartsWith("image/", System.StringComparison.OrdinalIgnoreCase))
            return Url.Content("~/" + img.TrimStart('/'));

        // If only a filename (no slash), assume it's in wwwroot/image
        if (!img.Contains("/"))
            return Url.Content("~/image/" + img);

        // Fallback: relative to wwwroot
        return Url.Content("~/" + img.TrimStart('/'));
    }
}

<section class="hero">
    <div class="hero-logo"></div>
</section>

<section class="categories-section">
    <h2 class="categories-title">Nos Catégories</h2>
    <div class="categories">
        <a class="category-btn @(currentFilter == "all" ? "active" : "")"
            href="@Url.Action("Filter", "Catalogue", new { type = "all" })">Tous</a>
        <a class="category-btn @(currentFilter == "burger" ? "active" : "")"
            href="@Url.Action("Filter", "Catalogue", new { type = "burger" })">Burger</a>
        <a class="category-btn @(currentFilter == "menu" ? "active" : "")"
            href="@Url.Action("Filter", "Catalogue", new { type = "menu" })">Menu</a>
        <a class="category-btn @(currentFilter == "boisson" ? "active" : "")"
            href="@Url.Action("Filter", "Catalogue", new { type = "boisson" })">Boisson</a>
        <a class="category-btn @(currentFilter == "frite" ? "active" : "")"
            href="@Url.Action("Filter", "Catalogue", new { type = "frite" })">Frite</a>
    </div>
</section>

<main class="main-content">
    <h2 class="section-title">@(
        currentFilter == "all" ? "Tous les produits" :
        currentFilter == "burger" ? "Burgers" :
        currentFilter == "menu" ? "Menus" :
        currentFilter == "boisson" ? "Boissons" :
        currentFilter == "frite" ? "Frites" : "Produits")
    </h2>

    <div class="products-grid">
        @if (!burgers.Any() && !menus.Any())
        {
            <div class="empty-state">Aucun produit correspondant.</div>
        }

        @* Complements (boisson, frite, etc.) *@
        @{
            var complements = ViewBag.Complements as List<Models.Complement> ?? new List<Models.Complement>();
        }
        @if (complements.Any())
        {
            @foreach (var c in complements)
            {
                <div class="product-card">
                    <div class="product-image" style="background-image: url('@ImgUrl(c.Image)')"></div>
                    <div class="product-info">
                        <div class="product-name">@c.Nom</div>
                        <div class="product-footer">
                            <span class="price">@c.Prix FCFA</span>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="add-btn" href="@Url.Action("Create", "Order")">Ajouter +</a>
                            }
                            else
                            {
                                <button class="add-btn" onclick="showLoginModal()">Ajouter +</button>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @* Burgers *@
        @foreach (var b in burgers)
        {
            <div class="product-card">
                <a href="@Url.Action("BurgerDetails", "Catalogue", new { id = b.Id })" class="product-image"
                    style="background-image: url('@ImgUrl(b.ImageUrl)')"></a>
                <div class="product-info">
                    <div class="product-name">@b.Nom</div>
                    <div class="product-footer">
                        <span class="price">@b.Prix FCFA</span>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="add-btn"
                                href="@Url.Action("Create", "Order", new { itemType = "Burger", itemId = b.Id })">Ajouter +</a>
                        }
                        else
                        {
                            <button class="add-btn" onclick="showLoginModal('Burger', @b.Id)">Ajouter +</button>
                        }
                    </div>
                </div>
            </div>
        }

        @* Menus *@
        @foreach (var m in menus)
        {
            <div class="product-card">
                <a href="@Url.Action("MenuDetails", "Catalogue", new { id = m.Id })" class="product-image"
                    style="background-image: url('@ImgUrl(m.Image)')"></a>
                <div class="product-info">
                    <div class="product-name">@m.Nom</div>
                    <div class="product-footer">
                        <span class="price">@m.PrixTotal FCFA</span>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="add-btn"
                                href="@Url.Action("Create", "Order", new { itemType = "Menu", itemId = m.Id })">Ajouter +</a>
                        }
                        else
                        {
                            <button class="add-btn" onclick="showLoginModal('Menu', @m.Id)">Ajouter +</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</main>

@* If user was redirected here to login before creating an order, open the login modal with preselection *@
@{
    var promptType = TempData["promptLoginItemType"] as string;
    var promptId = TempData["promptLoginItemId"] as string;
}

@if (!string.IsNullOrWhiteSpace(promptType))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var id = @((promptId != null) ? promptId : "null");
                // call with type and id (id may be null)
                showLoginModal('@promptType', id);
            } catch (e) { console.error(e); }
        });
    </script>
}

<!-- Modal de connexion -->
<div class="modal-overlay" id="loginModal" onclick="closeModalOnOverlay(event, 'loginModal')">
    <div class="login-modal">
        <h2 class="modal-title">Se connecter</h2>

        <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="login">Login</label>
                <input name="login" type="text" id="login" placeholder="Entrez votre login" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input name="password" type="password" id="password" placeholder="Entrez votre mot de passe" required />
            </div>

            <input type="hidden" name="returnUrl" id="loginReturnUrl" value="" />

            <button type="submit" class="connexion-btn">Connexion</button>
        </form>

        <div class="inscription-link">
            Pas de compte ? <a onclick="showInscriptionModal()">Inscription</a>
        </div>
    </div>
</div>

<!-- Modal d'inscription -->
<div class="modal-overlay" id="inscriptionModal" onclick="closeModalOnOverlay(event, 'inscriptionModal')">
    <div class="login-modal" style="max-width: 500px;">
        <h2 class="modal-title">S'inscrire</h2>

        <form id="registerForm" asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="nom">Nom</label>
                <input name="nom" type="text" id="nom" placeholder="Votre nom" required />
            </div>

            <div class="form-group">
                <label for="prenom">Prénom</label>
                <input name="prenom" type="text" id="prenom" placeholder="Votre prénom" required />
            </div>

            <div class="form-group">
                <label for="adresse">Adresse</label>
                <input name="adresse" type="text" id="adresse" placeholder="Votre adresse de livraison" required />
            </div>

            <div class="form-group">
                <label for="telephone">Téléphone</label>
                <input name="telephone" type="tel" id="telephone" placeholder="Ex: +221 77 123 45 67" required />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input name="email" type="email" id="email" placeholder="votre.email@exemple.com" required />
            </div>

            <div class="form-group">
                <label for="login-inscription">Login</label>
                <input name="login" type="text" id="login-inscription" placeholder="Choisissez un login" required />
            </div>

            <div class="form-group">
                <label for="password-inscription">Password</label>
                <input name="password" type="password" id="password-inscription"
                    placeholder="Choisissez un mot de passe" required />
            </div>

            <input type="hidden" name="returnUrl" id="registerReturnUrl" value="" />

            <button type="submit" class="connexion-btn">S'inscrire</button>

            <div class="inscription-link">
                Déjà un compte ? <a onclick="showLoginModal()">Se connecter</a>
            </div>
        </form>
    </div>
</div>