{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title"> Gestion des Commandes</h1>
    <p class="page-subtitle">{{ commandes|length }} commande(s)</p>
</div>

{# Inclure le formulaire de filtrage #}
{% include 'commande/_filter_form.html.twig' %}

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>N° Commande</th>
                <th>Date</th>
                <th>Client</th>
                <th>Type</th>
                <th>Montant</th>
                <th>Paiement</th>
                <th>État</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
            <tr>
                <td><strong>#{{ commande.id }}</strong></td>
                <td>{{ commande.created_at|date('d/m/Y') }}</td>
                <td>Client ID: {{ commande.client_profil_id ?? 'N/A' }}</td>
                <td>
                    {% set type = commande.type_livraison %}
                    {% if type == 'Sur_place' %}
                        <span class="badge badge-info">Sur place</span>
                    {% elseif type == 'A_retirer' %}
                        <span class="badge badge-warning">À retirer</span>
                    {% elseif type == 'A_livrer' %}
                        <span class="badge" style="background: #9C27B0; color: white;">À livrer</span>
                    {% else %}
                        <span class="badge" style="background:#ccc; color:#333;">—</span>
                    {% endif %}
                </td>
                <td><strong>{{ commande.total_prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                <td>
                    {% if commande.payement %}
                        {% set statut = commande.payement.statut_payement %}
                        {% set methode = commande.payement.methode_payement %}
                        {% if statut == 'Valider' %}
                            {% if methode == 'Orange_Money' %}
                                <span class="badge badge-success">OM</span>
                            {% elseif methode == 'Wave' %}
                                <span class="badge badge-success">Wave</span>
                            {% else %}
                                <span class="badge badge-success">Payé</span>
                            {% endif %}
                        {% elseif statut == 'Annuler' %}
                            <span class="badge badge-danger">Annulé</span>
                        {% else %}
                            <span class="badge badge-info">{{ statut|default('En attente') }}</span>
                        {% endif %}
                    {% else %}
                        <span class="badge badge-danger">✗ Non payé</span>
                    {% endif %}
                </td>
                <td>
                    {% if commande.state_order == 'En_cours' %}
                        <span class="badge badge-warning"> En cours</span>
                    {% elseif commande.state_order == 'Terminee' %}
                        <span class="badge badge-success">✓ Terminée</span>
                    {% else %}
                        <span class="badge badge-info">{{ commande.state_order }}</span>
                    {% endif %}
                </td>
                <td>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="{{ path('app_commande_show', {id: commande.id}) }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Voir</a>
                        {% if commande.state_order == 'En_cours' %}
                            <form method="post" action="{{ path('app_commande_terminer', {id: commande.id}) }}" style="display: inline;">
                                <button type="submit" class="btn btn-success" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Terminer</button>
                            </form>
                            <form method="post" action="{{ path('app_commande_annuler', {id: commande.id}) }}" style="display: inline;">
                                <button type="submit" class="btn btn-danger" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="return confirm('Annuler cette commande ?')">Annuler</button>
                            </form>
                        {% endif %}
                    </div>
                </td>
                <td>
                    {% set etat = commande.state_order %}
                    {% if etat == 'En_cours' %}
                        <span class="badge badge-warning">En cours</span>
                    {% elseif etat == 'Terminee' %}
                        <span class="badge badge-success">✓ Terminée</span>
                    {% elseif etat %}
                        <span class="badge badge-info">{{ etat }}</span>
                    {% else %}
                        <span class="badge" style="background:#ccc; color:#333;">—</span>
                    {% endif %}
                </td>
            {% endfor %}
        </tbody>
    </table>
</div>

<div style="margin-top: 1rem;">
    <a href="{{ path('app_home') }}" class="btn" style="background: #ddd; color: #333;">← Retour</a>
</div>
{% endblock %}