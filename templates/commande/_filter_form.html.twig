{# Formulaire de filtrage des commandes #}
<div class="card" style="margin-bottom: 1.5rem; background: linear-gradient(135deg, #FFF9E6 0%, #FFFBF0 100%);">
    <div style="padding: 1.5rem;">
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: #333;"> Filtrer les commandes</h3>
        
        {{ form_start(form, {'attr': {'method': 'GET', 'style': 'display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;'}}) }}
            
            <div class="form-group" style="margin-bottom: 0;">
                {{ form_label(form.state_order, 'État') }}
                {{ form_widget(form.state_order, {
                    'attr': {'class': 'form-control form-select', 'style': 'height: auto;'}
                }) }}
                {% if form.state_order.vars.errors %}
                    <div class="invalid-feedback" style="display: block;">
                        {% for error in form.state_order.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                {{ form_label(form.type_livraison, 'Type de livraison') }}
                {{ form_widget(form.type_livraison, {
                    'attr': {'class': 'form-control form-select', 'style': 'height: auto;'}
                }) }}
                {% if form.type_livraison.vars.errors %}
                    <div class="invalid-feedback" style="display: block;">
                        {% for error in form.type_livraison.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                {{ form_label(form.date, 'Date') }}
                {{ form_widget(form.date, {
                    'attr': {'class': 'form-control', 'type': 'date'}
                }) }}
                {% if form.date.vars.errors %}
                    <div class="invalid-feedback" style="display: block;">
                        {% for error in form.date.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div style="display: flex; align-items: flex-end; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1; padding: 0.6rem;">
                     Filtrer
                </button>
                <a href="{{ path('app_commande_index') }}" class="btn" style="flex: 1; padding: 0.6rem; background: #ddd; color: #333; text-align: center; text-decoration: none;">
                    ↻ Réinitialiser
                </a>
            </div>

        {{ form_end(form) }}
    </div>
</div>
