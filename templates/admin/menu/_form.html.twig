{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
<div class="form-group">
    {{ form_label(form.nom, 'Nom du menu', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.burger_id, 'Burger', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.burger_id, {'attr': {'class': 'form-select', 'id': 'burger_select'}}) }}
    <small class="text-muted">Sélectionnez un burger pour voir son prix</small>
</div>
<div class="form-group">
    {{ form_label(form.complements, 'Complements inclus', {'label_attr': {'class': 'form-label'}}) }}
    <div class="complements-checkboxes">
        {% for checkbox in form.complements %}
            <div class="form-check">
                {{ form_widget(checkbox, {'attr': {'class': 'form-check-input', 'data-complement-id': checkbox.vars.value}}) }}
                {{ form_label(checkbox, checkbox.vars.label, {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
        {% endfor %}
    </div>
    <small class="text-muted">Sélectionnez les complements inclus dans ce menu</small>
</div>
<div class="form-group">
    {{ form_label(form.prix_total, 'Prix total (FCFA)', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.prix_total, {'attr': {'class': 'form-control', 'readonly': 'readonly'}}) }}
    <small class="text-muted">Calculé automatiquement</small>
</div>
<div class="form-group">
    {{ form_label(form.image, 'Image', {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
</div>
<button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const burgerSelect = document.getElementById('burger_select');
    const complementCheckboxes = document.querySelectorAll('.complements-checkboxes input[type="checkbox"]');
    const prixTotalInput = document.querySelector('[name*="prix_total"]');
    
    // Fonction pour calculer le prix total
    async function calculateTotal() {
        let total = 0;
        let promises = [];
        
        // Récupérer le prix du burger sélectionné
        if (burgerSelect && burgerSelect.value) {
            const burgerPromise = fetch('{{ path("app_admin_api_burger_price") }}?id=' + burgerSelect.value)
                .then(response => response.json())
                .then(data => {
                    if (data.prix) {
                        return data.prix;
                    }
                    return 0;
                })
                .catch(error => {
                    console.error('Erreur burger:', error);
                    return 0;
                });
            promises.push(burgerPromise);
        }
        
        // Récupérer les prix des complements cochés
        if (complementCheckboxes.length > 0) {
            complementCheckboxes.forEach(checkbox => {
                if (checkbox.checked && checkbox.value) {
                    const complementPromise = fetch('{{ path("app_admin_api_complement_price") }}?id=' + checkbox.value)
                        .then(response => response.json())
                        .then(data => {
                            if (data.prix) {
                                return data.prix;
                            }
                            return 0;
                        })
                        .catch(error => {
                            console.error('Erreur complement:', error);
                            return 0;
                        });
                    promises.push(complementPromise);
                }
            });
        }
        
        // Attendre toutes les réponses et calculer le total
        try {
            const prices = await Promise.all(promises);
            total = prices.reduce((sum, price) => sum + price, 0);
            
            // Mettre à jour le champ prix total
            if (prixTotalInput) {
                prixTotalInput.value = total;
                console.log('Prix total calculé:', total, 'FCFA');
            }
        } catch (error) {
            console.error('Erreur lors du calcul du total:', error);
        }
    }
    
    // Ajouter les écouteurs d'événements
    if (burgerSelect) {
        burgerSelect.addEventListener('change', calculateTotal);
    }
    
    if (complementCheckboxes.length > 0) {
        complementCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', calculateTotal);
        });
    }
    
    // Calculer au chargement si des valeurs sont déjà sélectionnées
    calculateTotal();
});
</script>

<style>
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
        display: block;
    }
    
    .complements-checkboxes {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    
    .form-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .form-check-input {
        width: 18px;
        height: 18px;
        margin: 0;
        cursor: pointer;
        accent-color: #ffc107;
    }
    
    .form-check-label {
        margin: 0;
        cursor: pointer;
        user-select: none;
    }
    
    .text-muted {
        font-size: 0.875rem;
        color: #6c757d;
        display: block;
        margin-top: 0.25rem;
    }
    
    .btn {
        padding: 0.5rem 1.5rem;
        border: none;
        border-radius: 0.25rem;
        cursor: pointer;
        font-size: 1rem;
    }
    
    .btn-primary {
        background-color: #ffc107;
        color: #000;
        font-weight: 600;
    }
    
    .btn-primary:hover {
        background-color: #ffb300;
    }
</style>