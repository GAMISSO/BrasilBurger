{% extends 'base.html.twig' %}

{% block title %}Gestion des Burgers{% endblock %}

{% block body %}
<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 class="page-title"> Gestion des Burgers</h1>
        <p class="page-subtitle">{{ burgers|length }} burger(s) disponible(s)</p>
    </div>
    <a href="{{ path('app_admin_burger_new') }}" class="btn btn-primary">+ Nouveau Burger</a>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>Date création</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for burger in burgers %}
            <tr>
                <td>
                    {% if burger.image_url %}
                        <img src="{{ burger.image_url }}" alt="{{ burger.nom }}" 
                             style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;">
                    {% else %}
                        <div style="width: 80px; height: 80px; background: #f0f0f0; border-radius: 8px; display: flex; align-items: center; justify-content: center;">Pas d'image</div>
                    {% endif %}
                </td>
                <td><strong>{{ burger.nom }}</strong></td>
                <td><strong style="color: #4CAF50;">{{ burger.prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                <td>{{ burger.created_at|date('d/m/Y') }}</td>
                <td>
                    <div style="display: flex; gap: 0.5rem;">
                        <a href="{{ path('app_admin_burger_edit', {id: burger.id}) }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Modifier</a>
                        <form method="post" action="{{ path('app_admin_burger_delete', {id: burger.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ burger.id) }}">
                            <button type="submit" class="btn btn-danger" style="padding: 0.5rem 1rem; font-size: 0.9rem;" 
                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce burger ?')">Supprimer</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" style="text-align: center; padding: 2rem; color: #999;">
                    Aucun burger disponible. <a href="{{ path('app_admin_burger_new') }}">Créer le premier burger</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    {% if totalPages > 1 %}
    <div style="padding: 1.5rem; border-top: 1px solid #e0e0e0; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
        {% if currentPage > 1 %}
            <a href="{{ path('app_admin_burger_index', {page: currentPage - 1}) }}" class="btn" style="padding: 0.5rem 1rem;">← Précédent</a>
        {% endif %}
        
        {% for p in 1..totalPages %}
            {% if p == currentPage %}
                <span class="btn btn-primary" style="padding: 0.5rem 1rem;">{{ p }}</span>
            {% elseif p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}
                <a href="{{ path('app_admin_burger_index', {page: p}) }}" class="btn" style="padding: 0.5rem 1rem;">{{ p }}</a>
            {% elseif p == currentPage - 3 or p == currentPage + 3 %}
                <span style="padding: 0.5rem;">...</span>
            {% endif %}
        {% endfor %}
        
        {% if currentPage < totalPages %}
            <a href="{{ path('app_admin_burger_index', {page: currentPage + 1}) }}" class="btn" style="padding: 0.5rem 1rem;">Suivant →</a>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}