{% extends 'base.html.twig' %}

{% block title %}Dashboard - Brasil Burger{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Vue d'ensemble - {{ date|date('d/m/Y') }}</p>
</div>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="card" style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes en cours</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandesEnCours }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes validées</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandesValidees }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); color: #000;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Recettes</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.recettesJournalieres|number_format(0, ',', ' ') }} FCFA</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes annulées</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandesAnnulees }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>
</div>

<div class="card">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">🔥 Burgers/Menus les plus vendus</h2>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Produit</th>
                <th>Type</th>
                <th>Quantité vendue</th>
                <th>Prix unitaire</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in stats.topProduits %}
            <tr>
                <td><strong>{{ loop.index }}</strong></td>
                <td>{{ item.nom }}</td>
                <td>
                    {% if item.type == 'menu' %}
                        <span class="badge badge-info">Menu</span>
                    {% else %}
                        <span class="badge badge-warning">Burger</span>
                    {% endif %}
                </td>
                <td><strong>{{ item.quantite }}</strong></td>
                <td>{{ item.prix|number_format(0, ',', ' ') }} FCFA</td>
                <td><strong>{{ (item.quantite * item.prix)|number_format(0, ',', ' ') }} FCFA</strong></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700;">📦 Commandes récentes</h2>
        <a href="{{ path('app_commande_index') }}" class="btn btn-primary">Voir toutes les commandes</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>N° Commande</th>
                <th>Client</th>
                <th>Date</th>
                <th>Type</th>
                <th>Montant</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandesRecentes %}
            <tr>
                <td><strong>#{{ commande.id }}</strong></td>
                <td>{{ commande.client.prenom }} {{ commande.client.nom }}</td>
                <td>{{ commande.created_at|date('d/m/Y H:i') }}</td>
                <td>
                    {% if commande.type == 'sur_place' %}
                        Sur place
                    {% elseif commande.type == 'a_emporter' %}
                        À emporter
                    {% else %}
                        À livrer
                    {% endif %}
                </td>
                <td><strong>{{ commande.montant_total|number_format(0, ',', ' ') }} FCFA</strong></td>
                <td>
                    {% if commande.etat == 'en_cours' %}
                        <span class="badge badge-warning">En cours</span>
                    {% elseif commande.etat == 'termine' %}
                        <span class="badge badge-success">Terminé</span>
                    {% elseif commande.etat == 'annule' %}
                        <span class="badge badge-danger">Annulé</span>
                    {% else %}
                        <span class="badge badge-info">{{ commande.etat }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_commande_show', {id: commande.id}) }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Voir</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}