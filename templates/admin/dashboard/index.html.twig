{% extends 'base.html.twig' %}

{% block title %}Dashboard - Brasil Burger{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Vue d'ensemble - {{ date|date('d/m/Y') }}</p>
</div>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="card" style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes en cours</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandes_en_cours }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes validées</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandes_validees }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); color: #000;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Recettes</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.recettes_journalieres|number_format(0, ',', ' ') }} FCFA</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>

    <div class="card" style="background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%); color: white;">
        <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem;">Commandes annulées</div>
        <div style="font-size: 2.5rem; font-weight: 900;">{{ stats.commandes_annulees }}</div>
        <div style="font-size: 0.85rem; opacity: 0.8; margin-top: 0.5rem;">Aujourd'hui</div>
    </div>
</div>

<div class="card">
    <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;"> Produits les plus vendus</h2>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Type</th>
                <th>Produit ID</th>
                <th>Quantité vendue</th>
            </tr>
        </thead>
        <tbody>
            {% for item in stats.produits_populaires %}
            <tr>
                <td><strong>{{ loop.index }}</strong></td>
                <td>
                    {% if item.item_type == 'menu' %}
                        <span class="badge badge-info">Menu</span>
                    {% else %}
                        <span class="badge badge-warning">Burger</span>
                    {% endif %}
                </td>
                <td>
                    {% if item.item_type == 'menu' %}
                        Menu #{{ item.menu_id ?? 'N/A' }}
                    {% else %}
                        Burger #{{ item.burger_id ?? 'N/A' }}
                    {% endif %}
                </td>
                <td><strong>{{ item.total_ventes }}</strong></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700;"> Commandes récentes</h2>
        <a href="{{ path('app_commande_index') }}" class="btn btn-primary">Voir toutes les commandes</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>N° Commande</th>
                <th>Client</th>
                <th>Date</th>
                <th>Type</th>
                <th>Montant</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandesRecentes %}
            <tr>
                <td><strong>#{{ commande.id }}</strong></td>
                <td>Client ID: {{ commande.client_profil_id ?? 'N/A' }}</td>
                <td>{{ commande.created_at|date('d/m/Y H:i') }}</td>
                <td>
                    {% if commande.type_livraison == 'Sur_place' %}
                        Sur place
                    {% elseif commande.type_livraison == 'A_retirer' %}
                        À retirer
                    {% else %}
                        À livrer
                    {% endif %}
                </td>
                <td><strong>{{ commande.total_prix|number_format(0, ',', ' ') }} FCFA</strong></td>
                <td>
                    {% if commande.state_order == 'En_cours' %}
                        <span class="badge badge-warning">En cours</span>
                    {% elseif commande.state_order == 'Terminee' %}
                        <span class="badge badge-success">Terminée</span>
                    {% elseif commande.state_order == 'Annulee' %}
                        <span class="badge badge-danger">Annulée</span>
                    {% else %}
                        <span class="badge badge-info">{{ commande.state_order }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_commande_show', {id: commande.id}) }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Voir</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}