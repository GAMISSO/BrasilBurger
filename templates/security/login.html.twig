{% extends 'base.html.twig' %}

{% block title %}Connexion - Brasil Burger{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-5">
            <div class="card shadow-lg">
                <div class="card-header bg-warning text-center py-4">
                    <h2 class="mb-0"> Brasil Burger</h2>
                    <p class="mb-0">Espace Gestionnaire</p>
                </div>
                <div class="card-body p-4">
                    {% if error %}
                        <div class="alert alert-danger">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {{ form_start(form) }}
                        {{ form_row(form.login, {
                            'attr': {
                                'value': last_username
                            }
                        }) }}
                        {{ form_row(form.password) }}
                        {{ form_row(form.remember_me) }}
                        
                        <button type="submit" class="btn btn-brasil w-100 btn-lg mb-3">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}