{% extends 'base.html.twig' %}

{% block title %}Gestion des Livraisons{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title"> Gestion des Livraisons</h1>
    <p class="page-subtitle">Gérez les zones, les livreurs et les affectations</p>
</div>

<!-- Onglets -->
<div class="tabs-container">
    <div class="tabs-nav">
        <button class="tab-button active" data-tab="tab-zones"> Zones</button>
        <button class="tab-button" data-tab="tab-livreurs"> Livreurs</button>
        <button class="tab-button" data-tab="tab-zones-livreurs"> Affectations Zones-Livreurs</button>
        <button class="tab-button" data-tab="tab-affectations"> Affectations Commandes</button>
    </div>

    <!-- TAB 1: ZONES -->
    <div id="tab-zones" class="tab-content active">
        <div class="card">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Créer une nouvelle zone</h2>
            <form method="post" class="zone-form">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 1.5rem;">
                    <div>
                        <label class="form-label">Nom de la zone</label>
                        <input type="text" name="nom_zone" class="form-control" placeholder="Ex: Zone Dakar" required>
                    </div>
                    <div>
                        <label class="form-label">Prix zone (FCFA)</label>
                        <input type="number" name="prix_zone" class="form-control" placeholder="1000" min="0" required>
                    </div>
                    <button type="submit" name="creer_zone" class="btn btn-primary">+ Créer zone</button>
                </div>
            </form>
        </div>

        <div class="card">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Zones existantes ({{ zones|length }})</h2>
            {% if zones|length > 0 %}
            <table class="table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Créée le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for zone in zones %}
                    <tr>
                        <td><strong>#{{ zone.id }}</strong></td>
                        <td>{{ zone.nom }}</td>
                        <td><strong>{{ zone.prix_zone|number_format(0, ',', ' ') }} FCFA</strong></td>
                        <td>{{ zone.created_at|date('d/m/Y') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p style="text-align: center; color: #999; padding: 2rem;">Aucune zone créée pour le moment</p>
            {% endif %}
        </div>
    </div>

    <!-- TAB 2: LIVREURS -->
    <div id="tab-livreurs" class="tab-content">
        <div class="card">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Créer un nouveau livreur</h2>
            <form method="post" class="livreur-form">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; align-items: end; margin-bottom: 1.5rem;">
                    <div>
                        <label class="form-label">Nom du livreur</label>
                        <input type="text" name="nom_livreur" class="form-control" placeholder="Ex: Alioune Ndiaye" required>
                    </div>
                    <div>
                        <label class="form-label">Disponibilité</label>
                        <select name="disponibilite_livreur" class="form-select">
                            <option value="Disponible">Disponible</option>
                            <option value="Non_Disponible">Non Disponible</option>
                        </select>
                    </div>
                    <button type="submit" name="creer_livreur" class="btn btn-primary">+ Créer livreur</button>
                </div>
            </form>
        </div>

        <div class="card">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Livreurs existants ({{ tousLivreurs|length }})</h2>
            {% if tousLivreurs|length > 0 %}
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1rem;">
                {% for livreur in tousLivreurs %}
                <div style="border: 2px solid #f0f0f0; border-radius: 8px; padding: 1rem; background: #fafafa;">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.8rem;">
                        <div>
                            <strong style="font-size: 1.1rem;">#{{ livreur.id }} - {{ livreur.nom }}</strong><br>
                            {% if livreur.disponibilite == 'Disponible' %}
                                <span class="badge badge-success">✓ Disponible</span>
                            {% else %}
                                <span class="badge badge-warning">⚠ Non disponible</span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Bouton pour affecter zones -->
                    <form method="post" style="margin-top: 0.8rem;">
                        <input type="hidden" name="livreur_id" value="{{ livreur.id }}">
                        <label class="form-label" style="margin-bottom: 0.5rem; font-size: 0.9rem;">Assigner des zones:</label>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; max-height: 150px; overflow-y: auto; margin-bottom: 0.8rem; padding: 0.5rem; background: white; border: 1px solid #ddd; border-radius: 4px;">
                            {% for zone in zones %}
                            <label style="display: flex; gap: 0.5rem; align-items: center; cursor: pointer; font-size: 0.9rem; margin: 0;">
                                <input type="checkbox" name="zone_ids[]" value="{{ zone.id }}" style="width: 16px; height: 16px; cursor: pointer; accent-color: #ffc107;">
                                <span>{{ zone.nom }} ({{ zone.prix_zone|number_format(0, ',', ' ') }} FCFA)</span>
                            </label>
                            {% endfor %}
                        </div>
                        <button type="submit" name="affecter_zone" class="btn btn-success" style="width: 100%; font-size: 0.9rem; padding: 0.5rem;">Affecter zones</button>
                    </form>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p style="text-align: center; color: #999; padding: 2rem;">Aucun livreur créé pour le moment</p>
            {% endif %}
        </div>
    </div>

    <!-- TAB 3: AFFECTATIONS ZONES-LIVREURS -->
    <div id="tab-zones-livreurs" class="tab-content">
        <div class="card">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Affectations Zones → Livreurs ({{ affectationsLivreurZone|length }})</h2>
            {% if affectationsLivreurZone|length > 0 %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Livreur</th>
                        <th>Disponibilité</th>
                        <th>Zone affectée</th>
                        <th>Prix zone</th>
                    </tr>
                </thead>
                <tbody>
                    {% for affectation in affectationsLivreurZone %}
                    <tr>
                        <td><strong>{{ affectation.livreur.nom }}</strong></td>
                        <td>
                            {% if affectation.livreur.disponibilite == 'Disponible' %}
                                <span class="badge badge-success">Disponible</span>
                            {% else %}
                                <span class="badge badge-warning">Non disponible</span>
                            {% endif %}
                        </td>
                        <td>{{ affectation.zone.nom }}</td>
                        <td><strong>{{ affectation.zone.prix_zone|number_format(0, ',', ' ') }} FCFA</strong></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p style="text-align: center; color: #999; padding: 2rem;">Aucune affectation zone-livreur pour le moment</p>
            {% endif %}
        </div>
    </div>

    <!-- TAB 4: AFFECTATIONS COMMANDES -->
    <div id="tab-affectations" class="tab-content">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            {% for zoneName, zoneData in commandesParZone %}
            <div class="card">
                <div style="background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); padding: 1rem; border-radius: 8px 8px 0 0; margin: -1.5rem -1.5rem 1rem -1.5rem;">
                    <h3 style="font-size: 1.3rem; font-weight: 900; color: #000; margin-bottom: 0.3rem;">
                         Zone: {{ zoneData.zone.nom }}
                    </h3>
                    <p style="color: #333; font-size: 0.9rem;">
                        Prix livraison: {{ zoneData.zone.prix_zone|number_format(0, ',', ' ') }} FCFA
                    </p>
                </div>

                <div style="margin-bottom: 1rem;">
                    <strong>{{ zoneData.commandes|length }} commande(s) à livrer</strong>
                </div>

                {% if zoneData.commandes|length > 0 %}
                {% for commande in zoneData.commandes %}
                <div style="border: 2px solid #f0f0f0; border-radius: 8px; padding: 1rem; margin-bottom: 0.8rem; background: #fafafa;">
                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                        <div>
                            <strong style="font-size: 1.1rem;">Commande #{{ commande.id }}</strong><br>
                            <span style="color: #666; font-size: 0.9rem;">
                                Client: {{ commande.clientProfil ? commande.clientProfil.nom ~ ' ' ~ commande.clientProfil.prenom : 'ID ' ~ commande.client_profil_id }}
                            </span>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge badge-warning">{{ commande.total_prix|number_format(0, ',', ' ') }} FCFA</span><br>
                            {% if commande.state_order == 'En_cours' %}
                                <small class="badge badge-info" style="margin-top: 4px;">En cours</small>
                            {% elseif commande.state_order == 'Terminee' %}
                                <small class="badge badge-success" style="margin-top: 4px;">Terminée</small>
                            {% endif %}
                        </div>
                    </div>
                    <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.5rem;">
                         {{ commande.adresse_livraison ?? 'Adresse non spécifiée' }}
                    </p>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <a href="{{ path('app_commande_show', {id: commande.id}) }}" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Voir</a>
                        {% if commande.livreur is null %}
                        <form method="post" action="{{ path('app_livraison_affecter', {id: commande.id}) }}" style="display: inline-flex; gap: 0.3rem; align-items: center;">
                            <select name="livreur_id" required style="padding: 0.4rem; border-radius: 6px; border: 2px solid #ddd; font-size: 0.85rem;">
                                <option value="">Choisir livreur</option>
                                {% for livreur in livreurs %}
                                <option value="{{ livreur.id }}">{{ livreur.nom }} ({{ livreur.disponibilite }})</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-success" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Affecter</button>
                        </form>
                        {% else %}
                        <span class="badge badge-success"> Affecté à: {{ commande.livreur.nom }}</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
                {% else %}
                <p style="text-align: center; color: #999; padding: 2rem;">Aucune commande à livrer dans cette zone</p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .tabs-container {
        margin-top: 1.5rem;
    }

    .tabs-nav {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #ddd;
    }

    .tab-button {
        padding: 0.75rem 1.5rem;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        color: #666;
        transition: all 0.3s;
    }

    .tab-button.active {
        border-bottom-color: #ffc107;
        color: #ffc107;
    }

    .tab-button:hover {
        color: #ffc107;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    .form-label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        width: 100%;
        padding: 0.5rem;
        border: 2px solid #ddd;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .form-control:focus, .form-select:focus {
        outline: none;
        border-color: #ffc107;
        box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.1);
    }

    .btn {
        padding: 0.5rem 1.5rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-primary {
        background-color: #ffc107;
        color: #000;
    }

    .btn-primary:hover {
        background-color: #ffb300;
    }

    .btn-success {
        background-color: #4CAF50;
        color: white;
    }

    .btn-success:hover {
        background-color: #45a049;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table thead {
        background-color: #f5f5f5;
    }

    .table th, .table td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .table tbody tr:hover {
        background-color: #f9f9f9;
    }

    .badge {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-success {
        background-color: #4CAF50;
        color: white;
    }

    .badge-warning {
        background-color: #ff9800;
        color: white;
    }

    .badge-info {
        background-color: #2196F3;
        color: white;
    }
</style>

<script>
    document.querySelectorAll('.tab-button').forEach(button => {
        button.addEventListener('click', function() {
            // Désactiver tous les boutons et contenus
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            // Activer le bouton cliqué et son contenu
            this.classList.add('active');
            const tabId = this.getAttribute('data-tab');
            document.getElementById(tabId).classList.add('active');
        });
    });
</script>{% endblock %}